    return (doc.body.textContent || '').replace(/ /g, ' ').split('\n')
      .map(function (l) { return l.replace(/\s+/g, ' ').trim(); })
      .filter(Boolean).join('\n');
  }
  function normSchool(rows) {
    return (rows || []).map(function (r) {
      var day = String(r.sdate || '').slice(0, 10);
      var time = String(r.stime || '').slice(0, 5);
