{%- comment -%}
  Giao diện dùng chung của trang Lịch làm việc, có hai ngôn ngữ (vi / en).
  Được nhúng bởi _pages/vi/lich.html (/vi/lich/) và _pages/lich.html (/schedule/);
  ngôn ngữ lấy theo page.lang. Cấu hình (API, Client ID Google) ở khối `lich:` trong _config.yml.
  Mọi chuỗi giao diện nằm trong từ điển I18N ở đầu thẻ script.
{%- endcomment -%}
<div id="lich-config" hidden
  data-lang="{{ page.lang }}"
  data-school-api="{{ site.lich.school_api }}"
  data-school-snapshot="{{ site.lich.school_snapshot }}"
  data-google-client="{{ site.lich.google_client_id }}"
  data-google-account="{{ site.lich.google_account }}"></div>

{% raw %}
<style>
  .lich {
    --lk-bg: var(--global-bg-color);
    --lk-ink: var(--global-text-color);
    --lk-muted: var(--global-text-color-light);
    --lk-line: var(--global-divider-color);
    --lk-surface: var(--global-card-bg-color);
    --lk-accent: var(--global-theme-color);
    --lk-accent-soft: color-mix(in srgb, var(--global-theme-color) 13%, var(--global-bg-color));
    --src-t: #2f6fd0;
    --src-g: #c0306f;
    --src-p: #6d4fc2;
    --st-todo: #5b6470;
    --st-todo-bg: #eceef1;
    --st-doing: #8a5200;
    --st-doing-bg: #fdf0d8;
    --st-done: #1d7244;
    --st-done-bg: #e0f2e8;
    --late: #b3204f;
    --late-bg: #fbe3eb;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 0.94rem;
    min-width: 0;
  }
  html[data-theme="dark"] .lich {
    --src-t: #7fb3ff;
    --src-g: #ff8fb1;
    --src-p: #b7a2f5;
    --st-todo: #b8bec6;
    --st-todo-bg: #262a2f;
    --st-doing: #f2bb55;
    --st-doing-bg: #33270f;
    --st-done: #74d6a0;
    --st-done-bg: #16301f;
    --late: #ff8fb1;
    --late-bg: #3a1a26;
  }
  @media (min-width: 1000px) {
    .lich {
      width: min(1240px, calc(100vw - 48px));
      position: relative;
      left: 50%;
      transform: translateX(-50%);
    }
  }
  .lich [hidden] { display: none !important; }
  .lich h2 { font-size: 1.1rem; font-weight: 650; margin: 0; }
  .lich h4, .lich p { margin: 0; }
  .lich button, .lich input, .lich select, .lich textarea { font: inherit; color: inherit; }
  .lich button { cursor: pointer; }
  .lich :focus-visible { outline: 2px solid var(--lk-accent); outline-offset: 2px; }
  .lich .muted { color: var(--lk-muted); }

  .lich .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.7rem 1rem; }
  .lich .week-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .lich .week-label { font-weight: 650; font-variant-numeric: tabular-nums; }
  .lich .btn {
    border: 1px solid var(--lk-line); background: var(--lk-bg); color: var(--lk-ink);
    border-radius: 6px; padding: 0.28rem 0.7rem; line-height: 1.4;
  }
  .lich .btn:hover { border-color: var(--lk-accent); color: var(--lk-accent); }
  .lich .btn.primary { background: var(--lk-accent); border-color: var(--lk-accent); color: var(--lk-bg); font-weight: 600; }
  .lich .btn.primary:hover { color: var(--lk-bg); filter: brightness(1.08); }
  .lich .btn.small { font-size: 0.8rem; padding: 0.1rem 0.55rem; }

  .lich .sources { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .lich .chip {
    --c: var(--src-t);
    display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid var(--lk-line);
    background: var(--lk-bg); border-radius: 999px; padding: 0.2rem 0.75rem 0.2rem 0.6rem;
  }
  .lich .chip[aria-pressed="false"] { opacity: 0.55; }
  .lich .chip[aria-pressed="false"] .dot { background: transparent; box-shadow: inset 0 0 0 2px var(--c); }
  .lich .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
  .lich .chip small { color: var(--lk-muted); font-size: 0.78rem; }
  .lich .filter { display: inline-flex; align-items: center; gap: 0.5rem; }

  .lich .notice { border: 1px solid var(--lk-line); border-left: 3px solid var(--lk-accent); border-radius: 6px; padding: 0.55rem 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; justify-content: space-between; }
  .lich .notice.warn { border-left-color: var(--st-doing); background: var(--st-doing-bg); }
  .lich .notice.err { border-left-color: var(--late); background: var(--late-bg); }
  .lich .notice .acts { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

  .lich .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.6rem; }
  .lich .sum { background: var(--lk-surface); border-radius: 8px; padding: 0.55rem 0.85rem; display: flex; flex-direction: column; min-width: 0; }
  .lich .sum b { font-size: 1.4rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .lich .sum span { color: var(--lk-muted); font-size: 0.78rem; }
  .lich .sum.alert { background: var(--late-bg); }
  .lich .sum.alert b { color: var(--late); }

  .lich .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; font-size: 0.78rem; color: var(--lk-muted); }
  .lich .week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.5rem; align-items: start; }
  .lich .day { border: 1px solid var(--lk-line); border-radius: 8px; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; min-height: 110px; }
  .lich .day.today { border-color: var(--lk-accent); background: var(--lk-accent-soft); }
  .lich .day-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.4rem; padding-bottom: 0.35rem; border-bottom: 1px solid var(--lk-line); }
  .lich .day-head { flex-wrap: wrap; }
  .lich .day-head b { font-weight: 650; white-space: nowrap; }
  .lich .day-head .date { color: var(--lk-muted); font-variant-numeric: tabular-nums; }
  .lich .badge-today { font-size: 0.7rem; font-weight: 650; color: var(--lk-accent); flex-basis: 100%; }
  .lich .day-body { display: flex; flex-direction: column; gap: 0.5rem; }
  .lich .empty { color: var(--lk-muted); font-size: 0.78rem; padding: 0.2rem 0.1rem; }

  .lich .ev {
    --c: var(--src-t);
    background: var(--lk-bg); border: 1px solid var(--lk-line); border-left: 4px solid var(--c);
    border-radius: 6px; padding: 0.45rem 0.55rem; display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;
  }
  .lich .ev.src-g { --c: var(--src-g); }
  .lich .ev.src-p { --c: var(--src-p); }
  .lich .ev.hl { background: var(--lk-accent-soft); border-color: var(--c); border-left-width: 6px; box-shadow: 0 0 0 1px var(--c); }
  .lich .ev.done h4 { text-decoration: line-through; color: var(--lk-muted); }
  .lich .ev-top { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .lich .ev-top time { font-weight: 600; font-variant-numeric: tabular-nums; font-size: 0.82rem; }
  .lich .src-label { font-size: 0.68rem; font-weight: 650; color: var(--c); letter-spacing: 0.04em; text-transform: uppercase; }
  .lich .ev h4 { font-size: 0.82rem; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
  .lich .clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; cursor: pointer; }
  .lich .clamp.open { -webkit-line-clamp: unset; display: block; }
  .lich .meta { font-size: 0.75rem; color: var(--lk-muted); overflow-wrap: anywhere; white-space: pre-line; }
  .lich .meta.clamp { -webkit-line-clamp: 2; }
  .lich .ev-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 0.35rem; }
  .lich .star { border: 0; background: none; font-size: 1.15rem; line-height: 1; padding: 0 0.15rem; color: var(--lk-muted); }
  .lich .star[aria-pressed="true"] { color: var(--c); }
  .lich .pill {
    display: inline-flex; align-items: center; gap: 0.35rem; border: 0; border-radius: 999px; padding: 0.05rem 0.55rem;
    font-size: 0.75rem; font-weight: 600; background: var(--st-todo-bg); color: var(--st-todo);
  }
  .lich .pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .lich .pill.doing { background: var(--st-doing-bg); color: var(--st-doing); }
  .lich .pill.done { background: var(--st-done-bg); color: var(--st-done); }
  .lich .pill.done::before { border-radius: 2px; }
  .lich .link-btn { border: 0; background: none; padding: 0; color: var(--lk-muted); font-size: 0.75rem; text-decoration: underline; }
  .lich .link-btn:hover { color: var(--lk-accent); }
  .lich a.link-btn { color: var(--lk-muted); }
  .lich .note-line { font-size: 0.75rem; background: var(--lk-surface); border-radius: 4px; padding: 0.15rem 0.4rem; overflow-wrap: anywhere; white-space: pre-line; }
  .lich .note-input { width: 100%; font-size: 0.8rem; }
  .lich .due-mark {
    display: flex; gap: 0.4rem; align-items: flex-start; font-size: 0.78rem; font-weight: 600; color: var(--late);
    border: 1px dashed var(--late); border-radius: 6px; padding: 0.3rem 0.5rem; background: var(--lk-bg); overflow-wrap: anywhere;
  }
  .lich .due-mark::before { content: "◆"; font-size: 0.6rem; margin-top: 0.25rem; }
  .lich .due-mark.ok { color: var(--lk-ink); border-color: var(--lk-muted); }

  .lich .panel { border: 1px solid var(--lk-line); border-radius: 10px; padding: 0.9rem; display: flex; flex-direction: column; gap: 0.8rem; min-width: 0; }
  .lich .panel-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; align-items: center; }
  .lich .add-task { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .lich .add-task input[type="text"] { flex: 1 1 200px; }
  .lich input[type="text"], .lich input[type="date"], .lich input[type="time"], .lich select, .lich textarea {
    background: var(--lk-bg); border: 1px solid var(--lk-line); border-radius: 6px; padding: 0.3rem 0.55rem; min-width: 0; color: var(--lk-ink);
  }
  .lich textarea { width: 100%; min-height: 110px; resize: vertical; }
  .lich .lanes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .lich .lane { background: var(--lk-surface); border-radius: 8px; padding: 0.6rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .lich .lane-head { display: flex; justify-content: space-between; align-items: center; font-weight: 650; }
  .lich .count { color: var(--lk-muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .lich .task { background: var(--lk-bg); border: 1px solid var(--lk-line); border-radius: 6px; padding: 0.5rem 0.6rem; display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .lich .task.done h4 { text-decoration: line-through; color: var(--lk-muted); }
  .lich .task h4 { font-size: 0.85rem; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
  .lich .task-meta, .lich .task-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .lich .tag { font-size: 0.7rem; color: var(--lk-muted); border: 1px solid var(--lk-line); border-radius: 4px; padding: 0 0.4rem; }
  .lich .due { font-size: 0.75rem; font-weight: 600; border-radius: 4px; padding: 0.05rem 0.45rem; background: var(--st-todo-bg); color: var(--st-todo); font-variant-numeric: tabular-nums; }
  .lich .due.late { background: var(--late-bg); color: var(--late); }
  .lich .due.soon { background: var(--st-doing-bg); color: var(--st-doing); }
  .lich .due.ok { background: var(--st-done-bg); color: var(--st-done); }

  .lich .row2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .lich .form { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.5rem; }
  .lich .form .wide { grid-column: 1 / -1; }
  .lich label.f { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.78rem; color: var(--lk-muted); }
  .lich label.f input, .lich label.f select { color: var(--lk-ink); font-size: 0.92rem; }
  .lich .hint { font-size: 0.78rem; color: var(--lk-muted); }
  .lich .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; border-top: 1px solid var(--lk-line); padding-top: 0.8rem; }
  .lich .foot:empty, .lich .foot .acts:only-child { justify-content: flex-end; }
  .lich .foot .acts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .lich code { font-size: 0.8rem; background: var(--lk-surface); padding: 0 0.3rem; border-radius: 3px; }

  @media (max-width: 1099px) {
    .lich .week { grid-template-columns: 1fr; }
    .lich .day-body { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .lich .day-head { justify-content: flex-start; gap: 0.6rem; }
  }
  @media (max-width: 860px) {
    .lich .lanes, .lich .row2 { grid-template-columns: 1fr; }
  }
</style>

<div class="lich" id="lich">
  <header class="bar">
    <div class="week-nav" role="group" aria-label="Week">
      <button class="btn" type="button" id="prev" data-i18n-aria="prevWeek" aria-label="Tuần trước">‹</button>
      <span class="week-label" id="week-label"></span>
      <button class="btn" type="button" id="next" data-i18n-aria="nextWeek" aria-label="Tuần sau">›</button>
      <button class="btn" type="button" id="today" data-i18n="today">Hôm nay</button>
      <button class="btn" type="button" id="refresh" data-i18n="refresh">Làm mới</button>
    </div>
    <a class="btn primary" href="#them-lich" style="text-decoration:none" data-i18n="addEventBtn">+ Lịch cá nhân</a>
  </header>

  <section class="bar" aria-label="Sources">
    <div class="sources" id="sources"></div>
    <label class="filter"><input type="checkbox" id="only-rel"> <span data-i18n="onlyRel">Chỉ hiện việc của trường tôi đã đánh dấu</span></label>
  </section>

  <section id="notices" style="display:flex;flex-direction:column;gap:0.5rem" aria-live="polite"></section>

  <section class="summary" id="summary" aria-label="Summary"></section>

  <section aria-labelledby="h-week" style="display:flex;flex-direction:column;gap:0.6rem">
    <div class="bar">
      <h2 id="h-week" data-i18n="weekH">Lịch trong tuần</h2>
      <div class="legend">
        <span data-i18n="legendStar">★ đánh dấu việc của trường liên quan đến tôi</span>
        <span class="pill" data-i18n="stTodo">Chưa làm</span><span class="pill doing" data-i18n="stDoing">Đang làm</span><span class="pill done" data-i18n="stDone">Đã xong</span>
        <span data-i18n="legendDue">◆ hạn công việc</span>
      </div>
    </div>
    <div class="week" id="week"></div>
  </section>

  <section class="panel" aria-labelledby="h-todo">
    <div class="panel-head">
      <h2 id="h-todo" data-i18n="todoH">Việc cần làm theo hạn</h2>
      <form class="add-task" id="task-form">
        <input type="text" id="task-title" data-i18n-ph="taskPh" data-i18n-aria="taskTitleAria" placeholder="Việc mới" aria-label="Tên việc mới" required>
        <input type="text" id="task-tag" list="task-tags" data-i18n-ph="taskTagPh" data-i18n-aria="taskTagAria" placeholder="Nhóm" aria-label="Nhóm việc" size="10">
        <datalist id="task-tags"></datalist>
        <input type="date" id="task-due" data-i18n-aria="taskDueAria" aria-label="Hạn hoàn thành" required>
        <button class="btn primary" type="submit" data-i18n="addTask">Thêm việc</button>
      </form>
    </div>
    <div class="lanes" id="lanes"></div>
  </section>

  <div class="row2">
    <section class="panel" id="them-lich" aria-labelledby="h-add">
      <h2 id="h-add" data-i18n="addEvH">Thêm lịch cá nhân</h2>
      <form class="form" id="ev-form">
        <label class="f"><span data-i18n="fDay">Ngày</span> <input type="date" id="ev-day" required></label>
        <label class="f"><span data-i18n="fTime">Giờ</span> <input type="time" id="ev-time" value="09:00"></label>
        <label class="f wide"><span data-i18n="fContent">Nội dung</span> <input type="text" id="ev-title" data-i18n-ph="evPh" placeholder="Ví dụ" required></label>
        <label class="f wide"><span data-i18n="fLoc">Địa điểm (không bắt buộc)</span> <input type="text" id="ev-loc"></label>
        <div class="wide"><button class="btn primary" type="submit" data-i18n="addEv">Thêm vào lịch</button></div>
      </form>
    </section>
    <section class="panel" aria-labelledby="h-note">
      <h2 id="h-note" data-i18n="noteH">Ghi chú tuần</h2>
      <textarea id="week-note" aria-label="Ghi chú tuần"></textarea>
      <p class="hint" data-i18n="noteHint">Tự lưu trên trình duyệt này, riêng cho từng tuần.</p>
    </section>
  </div>

  <footer class="foot">
    <div id="g-panel"></div>
    <div class="acts">
      <button class="btn small" type="button" id="export" data-i18n="exportBtn">Xuất tệp JSON</button>
      <label class="btn small" style="cursor:pointer"><span data-i18n="importBtn">Nhập từ tệp JSON</span> <input type="file" id="import" accept="application/json,.json" hidden></label>
    </div>
  </footer>
</div>

<script>
(function () {
  'use strict';

  var cfgEl = document.getElementById('lich-config');
  var API = cfgEl.dataset.schoolApi;
  var SNAP = cfgEl.dataset.schoolSnapshot;
  var CLIENT = (cfgEl.dataset.googleClient || '').trim();
  var ACCOUNT = (cfgEl.dataset.googleAccount || '').trim();
  var SCOPE = 'https://www.googleapis.com/auth/calendar.readonly';
  var STORE_KEY = 'lich.v1';
  var GOOGLE_KEY = 'lich.google.v1';

  var L = cfgEl.dataset.lang === 'en' ? 'en' : 'vi';
  var LOCALE = L === 'en' ? 'en-GB' : 'vi-VN';
  var I18N = {
    vi: {
      today: 'Hôm nay', refresh: 'Làm mới', prevWeek: 'Tuần trước', nextWeek: 'Tuần sau', addEventBtn: '+ Lịch cá nhân',
      onlyRel: 'Chỉ hiện việc của trường tôi đã đánh dấu', weekH: 'Lịch trong tuần',
      legendStar: '★ đánh dấu việc của trường liên quan đến tôi', legendDue: '◆ hạn công việc',
      todoH: 'Việc cần làm theo hạn', taskPh: 'Việc mới, ví dụ: Soạn đề thi cuối kỳ', taskTagPh: 'Nhóm',
      taskTagAria: 'Nhóm việc', taskTitleAria: 'Tên việc mới', taskDueAria: 'Hạn hoàn thành', addTask: 'Thêm việc',
      addEvH: 'Thêm lịch cá nhân', fDay: 'Ngày', fTime: 'Giờ', fContent: 'Nội dung', evPh: 'Ví dụ: Gặp nhóm sinh viên làm khoá luận',
      fLoc: 'Địa điểm (không bắt buộc)', addEv: 'Thêm vào lịch', noteH: 'Ghi chú tuần', weekNoteAria: 'Ghi chú tuần',
      noteHint: 'Tự lưu trên trình duyệt này, riêng cho từng tuần.',
      exportBtn: 'Xuất tệp JSON', importBtn: 'Nhập từ tệp JSON',
      srcT: 'Trường', srcG: 'Google', srcP: 'Cá nhân', stTodo: 'Chưa làm', stDoing: 'Đang làm', stDone: 'Đã xong',
      dow: 'Chủ nhật|Thứ Hai|Thứ Ba|Thứ Tư|Thứ Năm|Thứ Sáu|Thứ Bảy', weekLabel: 'Tuần {0} · {1} – {2}',
      chipLive: 'trực tiếp', chipSnap: 'bản lưu', chipLoading: 'đang tải', gOk: 'đã kết nối', gNoSetup: 'chưa kết nối',
      gSignedOut: 'chưa đăng nhập', pLocal: 'trên máy này',
      sumLate: 'việc quá hạn', sumToday: 'việc đến hạn hôm nay', sumRel: 'việc của trường đã đánh dấu, chưa xong', sumTotal: 'lịch đang hiển thị trong tuần',
      noticeSnap: 'Không gọi trực tiếp được hce.edu.vn từ trình duyệt ({0}). Đang dùng bản lưu của GitHub{1}.',
      snapAt: ', thay đổi gần nhất lúc {0}', retry: 'Thử lại',
      noticeFail: 'Không tải được lịch công tác của Trường: {0}', noticeLive: 'Lịch Trường lấy trực tiếp từ hce.edu.vn lúc {0}.',
      gNoSetupNote: 'Lịch Google chưa được kết nối.',
