---
layout: default
---
{%- comment -%}
  Bản sao _layouts/post.liquid của theme al-folio (al_folio_core 1.0.15), sửa ba điểm:

  1. Chữ trên giao diện bài viết (ngày đăng, …) hiển thị theo ngôn ngữ của bài (page.lang).
  2. Có dòng "Read in English / Đọc bằng tiếng Việt" khi bài có bản dịch cùng `ref`.
  3. Khung bình luận dùng Waline (_includes/waline.liquid) thay cho giscus: người đọc
     để tên hoặc ẩn danh, không cần tài khoản.

  LƯU Ý khi nâng cấp theme: nếu al-folio đổi file này, chép lại bản mới từ gem
  rồi áp dụng lại ba thay đổi trên.
{%- endcomment -%}
{% assign cur_lang = page.lang | default: 'en' %}
{% if cur_lang == 'vi' %}
  {% assign t_created = 'Đăng ngày' %}
  {% assign t_by = 'bởi' %}
  {% assign t_updated = 'cập nhật ngày' %}
  {% assign t_other_lang = 'Read in English' %}
  {% assign date_fmt = '%d/%m/%Y' %}
{% else %}
  {% assign t_created = 'Created on' %}
  {% assign t_by = 'by' %}
  {% assign t_updated = 'last updated on' %}
  {% assign t_other_lang = 'Đọc bằng tiếng Việt' %}
  {% assign date_fmt = '%B %d, %Y' %}
{% endif %}
{% assign translation = nil %}
{% if page.ref %}
  {% assign translations = site.posts | where: 'ref', page.ref %}
  {% for t in translations %}
    {% if t.lang != cur_lang %}{% assign translation = t %}{% endif %}
  {% endfor %}
{% endif %}
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% if page.collection == 'posts' %}
  {% assign is_blog = true %}
{% else %}
  {% assign is_blog = false %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ t_created }} {{ page.date | date: date_fmt }}
      {% if page.author %}{{ t_by }} {{ page.author }}{% endif %}
      {% assign last_date = page.last_modified_at | default: page.last_updated %}
      {% if last_date %}, {{ t_updated }} {{ last_date | date: date_fmt }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
      {% if translation %}
        &nbsp; &middot; &nbsp;
        <a href="{{ translation.url | relative_url }}" hreflang="{{ translation.lang }}">
          <i class="fa-solid fa-language fa-sm"></i> {{ t_other_lang }}</a
        >
      {% endif %}
    </p>
    <p class="post-tags">
      {% if is_blog %}
        <a href="{{ year | prepend: '/blog/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if is_blog %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if is_blog %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% include waline.liquid %}
</div>
