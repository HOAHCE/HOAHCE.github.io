  // ---------- Lịch của Trường ----------
  function htmlText(s) {
    s = String(s == null ? '' : s);
    if (/&lt;\/?[a-z]/i.test(s)) { var ta = document.createElement('textarea'); ta.innerHTML = s; s = ta.value; }
