  }
  function loadSnapshot() {
    if (school.snap) return Promise.resolve(school.snap);
    return fetchJson(SNAP + '?t=' + Math.floor(Date.now() / 300000), {}, 9000).then(function (j) {
      school.snap = normSchool(j.data);
      school.snapAt = j.updated || null;
      return school.snap;
    });
  }
  function loadSchool(force) {
    var key = weekKey(), mySeq = seq;
    if (!force && school.cache[key]) { school.status = 'live'; return Promise.resolve(); }
    school.status = 'loading';
    render();
    var days = weekDays();
    var body = JSON.stringify({ startdate: days[0], enddate: days[6], what: '210' });
    return fetchJson(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body }, 9000)
      .then(function (j) {
        var rows;
        if (j && Array.isArray(j.data)) rows = j.data;
