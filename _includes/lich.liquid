  function allEvents() {
    var days = weekDays(), list = [];
    if (store.prefs.src.t) list = list.concat(schoolItems());
    if (store.prefs.src.g) list = list.concat(gcal.items[weekKey()] || []);
    if (store.prefs.src.p) {
      list = list.concat(store.events.filter(function (e) { return e.day >= days[0] && e.day <= days[6]; })
        .map(function (e) { return { id: e.id, src: 'p', day: e.day, time: e.time || '', title: e.title, loc: e.loc || '' }; }));
    }
    return list.filter(function (e) {
