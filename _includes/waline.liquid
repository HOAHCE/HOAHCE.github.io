{%- comment -%}
  Khung bình luận Waline ở cuối bài blog.
  - Người đọc KHÔNG cần tài khoản: điền tên (hoặc để trống = ẩn danh) và nội dung.
  - Giao diện Waline theo ngôn ngữ của bài (page.lang: vi / en).
  - Bản tiếng Việt và tiếng Anh của cùng một bài (cùng `ref`) DÙNG CHUNG một luồng bình luận:
    bình luận ở trang này hiện ngay ở trang kia. Khoá chung là đường dẫn của bản tiếng Việt
    (nếu bài chỉ có bản tiếng Anh thì dùng đường dẫn của chính bài đó).
  - Chỉ hiện khi đã điền `waline.server_url` trong _config.yml.
  - Tắt ở một bài: thêm `comments: false` vào phần đầu bài.
{%- endcomment -%}
{%- assign waline_server = site.waline.server_url | strip -%}
{%- if waline_server != '' and page.comments != false -%}
  {%- assign cur_lang = page.lang | default: 'en' -%}
  {%- comment -%} Khoá luồng bình luận chung cho mọi bản dịch cùng `ref` {%- endcomment -%}
  {%- assign w_path = page.url -%}
  {%- if page.ref -%}
    {%- assign w_versions = site.posts | where: 'ref', page.ref -%}
    {%- for v in w_versions -%}
      {%- if v.lang == 'vi' -%}{%- assign w_path = v.url -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign w_meta = site.waline.meta | default: 'nick,mail' -%}
  {%- if w_meta.first == nil -%}{%- assign w_meta = w_meta | split: ',' -%}{%- endif -%}
  {%- assign w_required = site.waline.required_meta -%}
  {%- if w_required == nil or w_required == '' -%}{%- assign w_required = '' | split: ',' -%}{%- endif -%}
  {%- if cur_lang == 'vi' -%}
    {%- assign t_comments = 'Bình luận' -%}
    {%- assign t_hint = 'Không cần tài khoản — chỉ cần để tên, hoặc để trống để bình luận ẩn danh.' -%}
  {%- else -%}
    {%- assign t_comments = 'Comments' -%}
    {%- assign t_hint = 'No account needed — just leave your name, or leave it blank to comment anonymously.' -%}
  {%- endif -%}
  <div class="waline-section" style="max-width: {{ site.max_width }}; margin: 0 auto">
    <br>
    <hr>
    <h2 class="text-3xl font-semibold mb-4 mt-12">{{ t_comments }}</h2>
    <p class="post-meta">{{ t_hint }}</p>
    <div id="waline"></div>
  </div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css">
  <style>
    #waline {
      --waline-theme-color: var(--global-theme-color);
      --waline-active-color: var(--global-hover-color);
      --waline-bg-color: var(--global-bg-color);
      --waline-color: var(--global-text-color);
      --waline-border-color: var(--global-divider-color);
    }
  </style>
  <script type="module">
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    init({
      el: '#waline',
      serverURL: {{ waline_server | jsonify }},
      lang: {{ cur_lang | jsonify }},
      path: {{ w_path | jsonify }},
      dark: 'html[data-theme="dark"]',
      login: {{ site.waline.login | default: 'enable' | jsonify }},
      meta: {{ w_meta | jsonify }},
      requiredMeta: {{ w_required | jsonify }},
      imageUploader: false,
      search: false,
    });
  </script>
{%- endif -%}
