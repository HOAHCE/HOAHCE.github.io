  function dueInfo(task) {
    var n = diff(today(), task.due), d = fmt(task.due);
    if (task.st === 'done') return { cls: 'ok', txt: tr('dueDate', d) };
    if (n < 0) return { cls: 'late', txt: tr(n === -1 ? 'dueLate1' : 'dueLate', -n, d) };
    if (n === 0) return { cls: 'soon', txt: tr('dueToday') };
    if (n === 1) return { cls: 'soon', txt: tr('dueTomorrow', d) };
    if (n <= 7) return { cls: '', txt: tr('dueIn', n, d) };
    return { cls: '', txt: tr('dueDate', d) };
  }

  function renderBar() {
    var days = weekDays();
    $('week-label').textContent = tr('weekLabel', isoWeek(weekStart), fmt(days[0]), fmt(days[6]) + '/' + days[6].slice(0, 4));
    var counts = { t: schoolItems().length, g: (gcal.items[weekKey()] || []).length,
      p: store.events.filter(function (e) { return e.day >= days[0] && e.day <= days[6]; }).length };
    var notes = { t: school.status === 'live' ? tr('chipLive') : school.status === 'snapshot' ? tr('chipSnap') : school.status === 'loading' ? tr('chipLoading') : '—',
      g: gcal.status === 'ok' ? (gcal.email || tr('gOk')) : gcal.status === 'loading' ? tr('chipLoading') : gcal.status === 'nosetup' ? tr('gNoSetup') : tr('gSignedOut'),
      p: tr('pLocal') };
    $('sources').innerHTML = ['t', 'g', 'p'].map(function (k) {
      return '<button type="button" class="chip" data-src="' + k + '" aria-pressed="' + !!store.prefs.src[k] + '" style="--c:var(--src-' + k + ')">' +
        '<span class="dot"></span><b>' + SRC[k] + '</b> ' + counts[k] + ' <small>' + esc(notes[k]) + '</small></button>';
    }).join('');
    $('only-rel').checked = !!store.prefs.rel;
  }

  function retryBtn() {
    return '<span class="acts"><button class="btn small" type="button" data-act="refresh">' + esc(tr('retry')) + '</button></span>';
  }
  function renderNotices() {
    var h = '';
    if (school.status === 'snapshot') {
      var at = school.snapAt ? tr('snapAt', esc(new Date(school.snapAt).toLocaleString(LOCALE))) : '';
      h += '<div class="notice warn"><span>' + tr('noticeSnap', esc(school.err), at) + '</span>' + retryBtn() + '</div>';
    } else if (school.status === 'fail') {
      h += '<div class="notice err"><span>' + tr('noticeFail', esc(school.err)) + '</span>' + retryBtn() + '</div>';
    } else if (school.status === 'live' && school.at) {
      h += '<div class="notice"><span class="muted">' + tr('noticeLive', pad(school.at.getHours()) + ':' + pad(school.at.getMinutes())) + '</span></div>';
    }
    if (gcal.status === 'nosetup') {
      h += '<div class="notice"><span class="muted">' + esc(tr('gNoSetupNote')) + '</span></div>';
    } else if (gcal.status === 'signedout') {
      h += '<div class="notice"><span>' + esc(tr('gSignInMsg')) + (gcal.err ? ' <span class="muted">(' + esc(gcal.err) + ')</span>' : '') + '.</span>' +
        '<span class="acts"><label class="filter"><input type="checkbox" id="g-remember" checked> ' + esc(tr('remember')) + '</label>' +
        '<button class="btn primary small" type="button" data-act="g-signin">' + esc(tr('signInBtn')) + '</button></span></div>';
    } else if (gcal.status === 'resume') {
      h += '<div class="notice"><span>' + esc(tr('resumeMsg')) + '</span>' +
        '<span class="acts"><button class="btn primary small" type="button" data-act="g-resume">' + esc(tr('resumeBtn', gState.email)) + '</button>' +
        '<button class="btn small" type="button" data-act="g-forget">' + esc(tr('forgetBtn')) + '</button></span></div>';
    } else if (gcal.status === 'error') {
      h += '<div class="notice err"><span>' + esc(tr('gError', gcal.err)) + '</span>' + retryBtn() + '</div>';
    }
    if (!storageOk) {
      h += '<div class="notice warn"><span>' + esc(tr('storageWarn')) + '</span></div>';
    }
    $('notices').innerHTML = h;
  }

  function renderSummary() {
    var t0 = today(), days = weekDays();
    var late = store.tasks.filter(function (t) { return t.st !== 'done' && t.due < t0; }).length;
    var dueToday = store.tasks.filter(function (t) { return t.st !== 'done' && t.due === t0; }).length;
    var relOpen = schoolItems().filter(function (e) { var m = meta(e.id); return m.hl && (m.st || 'todo') !== 'done'; }).length;
    var total = allEvents().length;
    var items = [
      [late, tr('sumLate'), late ? ' alert' : ''],
      [dueToday, tr('sumToday'), dueToday ? ' alert' : ''],
      [relOpen, tr('sumRel'), ''],
      [total, tr('sumTotal'), '']
    ];
    $('summary').innerHTML = items.map(function (i) {
      return '<div class="sum' + i[2] + '"><b>' + i[0] + '</b><span>' + i[1] + '</span></div>';
    }).join('');
  }

  function evCard(e) {
    var m = meta(e.id), st = m.st || 'todo';
    var hasStatus = e.src === 'p' || (e.src === 't' && m.hl);
    var cls = 'ev src-' + e.src + (m.hl && e.src === 't' ? ' hl' : '') + (hasStatus && st === 'done' ? ' done' : '');
    var h = '<article class="' + cls + '"><div class="ev-top"><span class="src-label">' + SRC[e.src] + '</span><time>' + esc(e.time) + '</time>';
    if (e.src === 't') {
      h += '<button type="button" class="star" data-star="' + esc(e.id) + '" aria-pressed="' + !!m.hl + '" aria-label="' + esc(tr('starTitle')) + '" title="' + esc(tr('starTitle')) + '">' + (m.hl ? '★' : '☆') + '</button>';
    } else { h += '<span></span>'; }
    h += '</div><h4 class="' + (e.src === 't' ? 'clamp' : '') + '">' + esc(e.title) + '</h4>';
    if (e.loc) h += '<p class="meta">' + esc(e.loc) + '</p>';
    if (e.src === 't') {
      if (e.host) h += '<p class="meta">' + esc(tr('lblHost', e.host)) + '</p>';
      if (e.who) h += '<p class="meta clamp">' + esc(tr('lblWho', e.who)) + '</p>';
    }
    if (e.src === 'g' && e.cal) h += '<p class="meta">' + esc(e.cal) + '</p>';
    if (editingNote === e.id) {
      h += '<input type="text" class="note-input" data-note-for="' + esc(e.id) + '" value="' + esc(m.note || '') + '" placeholder="' + esc(tr('notePh')) + '">';
    } else if (m.note) {
      h += '<p class="note-line">' + esc(m.note) + '</p>';
    }
    h += '<div class="ev-foot">';
    if (hasStatus) h += '<button type="button" class="pill ' + st + '" data-st="' + esc(e.id) + '" title="' + esc(tr('stClick')) + '">' + STXT[st] + '</button>';
    h += '<button type="button" class="link-btn" data-note="' + esc(e.id) + '">' + esc(m.note ? tr('editNote') : tr('note')) + '</button>';
    if (e.src === 'g' && /^https:\/\//.test(e.link || '')) h += '<a class="link-btn" href="' + esc(e.link) + '" target="_blank" rel="noopener">' + esc(tr('openGoogle')) + '</a>';
    if (e.src === 'p') h += '<button type="button" class="link-btn" data-del-ev="' + esc(e.id) + '">' + esc(tr('del')) + '</button>';
    return h + '</div></article>';
  }

  function renderWeek() {
    var t0 = today(), evs = allEvents();
    $('week').innerHTML = weekDays().map(function (d) {
      var list = evs.filter(function (e) { return e.day === d; }).sort(function (a, b) { return sortKey(a) < sortKey(b) ? -1 : sortKey(a) > sortKey(b) ? 1 : 0; });
      var dues = store.tasks.filter(function (t) { return t.due === d && t.st !== 'done'; });
      var body = dues.map(function (t) {
        return '<div class="due-mark' + (t.due >= t0 ? ' ok' : '') + '">' + esc(tr('dueMark', t.title)) + '</div>';
      }).join('') + list.map(evCard).join('');
      if (!body) body = '<p class="empty">' + (school.status === 'loading' && store.prefs.src.t ? tr('loading') : tr('empty')) + '</p>';
      var dt = parseYmd(d), isToday = d === t0;
      return '<div class="day' + (isToday ? ' today' : '') + '"><div class="day-head"><b>' + DOW[dt.getDay()] + '</b><span class="date">' + fmt(d) + '</span>' +
        (isToday ? '<span class="badge-today">' + esc(tr('today')) + '</span>' : '') + '</div><div class="day-body">' + body + '</div></div>';
    }).join('');
    if (editingNote) {
      var inp = document.querySelector('[data-note-for="' + editingNote.replace(/"/g, '') + '"]');
      if (inp) inp.focus();
    }
  }

  function renderLanes() {
    var names = { todo: tr('laneTodo'), doing: tr('laneDoing'), done: tr('laneDone') };
    var btn = { todo: tr('btnStart'), doing: tr('btnFinish'), done: tr('btnReopen') };
    $('lanes').innerHTML = ['todo', 'doing', 'done'].map(function (st) {
      var list = store.tasks.filter(function (t) { return t.st === st; }).sort(function (a, b) { return a.due < b.due ? -1 : a.due > b.due ? 1 : 0; });
      var cards = list.map(function (t) {
        var di = dueInfo(t);
        return '<div class="task ' + t.st + '"><h4>' + esc(t.title) + '</h4><div class="task-meta"><span class="due ' + di.cls + '">' + esc(di.txt) + '</span>' +
          (t.tag ? '<span class="tag">' + esc(t.tag) + '</span>' : '') + '</div><div class="task-acts">' +
          '<button type="button" class="btn small" data-task="' + esc(t.id) + '">' + btn[st] + '</button>' +
          '<button type="button" class="link-btn" data-del-task="' + esc(t.id) + '">' + esc(tr('del')) + '</button></div></div>';
      }).join('') || '<p class="empty">' + esc(tr('noTasks')) + '</p>';
      return '<div class="lane"><div class="lane-head"><span>' + names[st] + '</span><span class="count">' + list.length + '</span></div>' + cards + '</div>';
    }).join('');
  }

  function renderGoogleSetup() {
    var h = '';
    if (CLIENT && (gTok || gcal.status === 'ok')) {
      h = '<p>' + tr('gPanelOn', gcal.email ? tr('withEmail', esc(gcal.email)) : '', esc(gState.remember ? tr('remembered') : tr('notRemembered'))) + '</p>' +
        '<div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.4rem"><button class="btn small" type="button" data-act="g-signout">' + esc(tr('signOutBtn')) + '</button>' +
        '<button class="btn small" type="button" data-act="g-forget">' + esc(tr('forgetRevoke')) + '</button></div>';
    }
    $('g-panel').innerHTML = h;
  }

  function render() {
    renderBar(); renderNotices(); renderSummary(); renderWeek(); renderLanes(); renderGoogleSetup();
    var note = $('week-note');
    if (document.activeElement !== note) note.value = store.notes[weekKey()] || '';
  }

  function loadAll(force) {
    seq++;
    var p = [loadSchool(force)];
    if (gTok) p.push(loadGoogle(force));
    render();
    return Promise.all(p);
  }

  // ---------- Sự kiện ----------
  function findTask(id) { return store.tasks.filter(function (t) { return t.id === id; })[0]; }

  document.getElementById('lich').addEventListener('click', function (ev) {
    var t = ev.target;
    var clamp = t.closest && t.closest('.clamp');
    if (clamp && !t.closest('button, a, input')) { clamp.classList.toggle('open'); return; }
    var b = t.closest && t.closest('button');
    if (!b) return;
    var d = b.dataset;
    if (d.src) { store.prefs.src[d.src] = !store.prefs.src[d.src]; save(); return render(); }
    if (d.star) { var m = meta(d.star); m.hl = !m.hl; if (!m.hl) { m.st = 'todo'; } save(); return render(); }
    if (d.st) { var m2 = meta(d.st); m2.st = NEXT[m2.st || 'todo']; save(); return render(); }
    if (d.note) { editingNote = d.note; return render(); }
    if (d.delEv) {
      if (!window.confirm(tr('confirmDelEv'))) return;
      store.events = store.events.filter(function (e) { return e.id !== d.delEv; }); delete store.meta[d.delEv]; save(); return render();
    }
    if (d.task) { var k = findTask(d.task); if (k) { k.st = NEXT[k.st]; save(); render(); } return; }
    if (d.delTask) {
      if (!window.confirm(tr('confirmDelTask'))) return;
      store.tasks = store.tasks.filter(function (x) { return x.id !== d.delTask; }); save(); return render();
    }
    if (d.act === 'refresh') return loadAll(true);
    if (d.act === 'g-signin') { var cb = $('g-remember'); return signIn(cb ? cb.checked : true); }
    if (d.act === 'g-resume') return signIn(true);
    if (d.act === 'g-signout') return signOutGoogle(false);
    if (d.act === 'g-forget') return signOutGoogle(true);
  });

  function commitNote(input) {
    var id = input.dataset.noteFor, v = input.value.trim();
    var m = meta(id);
    if (v) m.note = v; else delete m.note;
    editingNote = null; save(); render();
  }
  document.getElementById('lich').addEventListener('keydown', function (ev) {
    var i = ev.target;
    if (!i.dataset || !i.dataset.noteFor) return;
    if (ev.key === 'Enter') { ev.preventDefault(); commitNote(i); }
    if (ev.key === 'Escape') { editingNote = null; render(); }
  });
  document.getElementById('lich').addEventListener('focusout', function (ev) {
    var i = ev.target;
    if (i.dataset && i.dataset.noteFor && editingNote === i.dataset.noteFor) commitNote(i);
  });

  $('prev').addEventListener('click', function () { weekStart = addDays(weekStart, -7); loadAll(false); });
  $('next').addEventListener('click', function () { weekStart = addDays(weekStart, 7); loadAll(false); });
  $('today').addEventListener('click', function () { weekStart = mondayOf(new Date()); loadAll(false); });
  $('refresh').addEventListener('click', function () { loadAll(true); });
  $('only-rel').addEventListener('change', function (e) { store.prefs.rel = e.target.checked; save(); render(); });

  $('task-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var title = $('task-title').value.trim();
    if (!title || !$('task-due').value) return;
    store.tasks.push({ id: uid(), title: title, due: $('task-due').value, tag: $('task-tag').value.trim(), st: 'todo' });
    $('task-title').value = ''; save(); render();
  });
  $('ev-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var title = $('ev-title').value.trim();
    if (!title || !$('ev-day').value) return;
    store.events.push({ id: 'p' + uid(), day: $('ev-day').value, time: $('ev-time').value || '', title: title, loc: $('ev-loc').value.trim() });
    $('ev-title').value = ''; $('ev-loc').value = '';
    var d = parseYmd(store.events[store.events.length - 1].day);
    weekStart = mondayOf(d);
    save(); loadAll(false);
  });
  var noteTimer = null;
  $('week-note').addEventListener('input', function (e) {
    var v = e.target.value, k = weekKey();
    clearTimeout(noteTimer);
    noteTimer = setTimeout(function () { if (v.trim()) store.notes[k] = v; else delete store.notes[k]; save(); }, 400);
  });

  $('export').addEventListener('click', function () {
    var blob = new Blob([JSON.stringify(store, null, 2)], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'lich-lam-viec-' + today() + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  });
  $('import').addEventListener('change', function (e) {
    var f = e.target.files[0];
    if (!f) return;
    var r = new FileReader();
    r.onload = function () {
      try {
        var j = JSON.parse(r.result);
        if (!j || typeof j !== 'object' || !Array.isArray(j.tasks)) throw new Error('bad');
        if (!window.confirm(tr('confirmImport'))) return;
        store = normStore(j); save(); render();
      } catch (err) { window.alert(tr('badFile')); }
      e.target.value = '';
    };
    r.readAsText(f);
  });

  // ---------- Khởi động ----------
  applyI18n();
  $('task-due').value = ymd(addDays(new Date(), 7));
  $('ev-day').value = today();
  render();
  loadSchool(false);
  initGoogle();
})();
</script>
{% endraw %}
